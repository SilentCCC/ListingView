NODE_ENV=development
PORT=5172
DATA_DIR=../data
CLIENT_DIST_DIR=../client/dist
MAX_FILE_SIZE_MB=10
CORS_ORIGIN=http://localhost:5173
# 可选：设置管理员密码；留空时默认开启完整编辑模式，设置后需要输入密码才显示编辑选项
ADMIN_PASSWORD=
# 可选：OpenAI 兼容视觉接口的 API 根地址，例如 https://api.example.com/v1
VISION_API_BASE_URL=
# 服务端私密密钥；不要填写到前端环境变量，也不要提交真实密钥
VISION_API_KEY=
# 已开通图片/视觉能力的模型名称
VISION_MODEL=
